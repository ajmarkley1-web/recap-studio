__pycache__/
venv/
.venv/
.ipynb_checkpoints/
*.pyc

# Model checkpoints. The CRAFT text-detector weights are 79 MB and the default
# code path never loaded them. Re-download from the CRAFT project if you want to
# run the old Python text detector.
*.pth
*.pt
*.onnx
*.safetensors

