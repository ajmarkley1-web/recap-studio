# Normalize line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never munge binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.pth binary
*.woff binary
*.woff2 binary
